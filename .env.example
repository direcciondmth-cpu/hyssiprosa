# ── Neon PostgreSQL ──────────────────────────────────────────────────
# Copiá la "Connection string" de tu proyecto Neon (Dashboard → Connection Details → Pooled)
DATABASE_URL=postgres://user:password@host.neon.tech/dbname?sslmode=require

# ── Token de sesión ──────────────────────────────────────────────────
# Cadena aleatoria larga (mínimo 32 caracteres). Generala con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SIPROSA_TOKEN_SECRET=reemplaza_esto_por_un_string_largo_aleatorio

# ── Copia este archivo como .env.local para desarrollo local ─────────
# En Vercel, configurá estas variables en Project → Settings → Environment Variables
